#!/data/data/com.termux/files/usr/bin/bash
# clion-start — Termux launcher for JetBrains CLion (env-mode aware)
#
# Usage:
#   clion-start [ENV_MODE] [--] [CLion args...]
#
# If ENV_MODE omitted: uses $ENV_MODE if set, else defaults to mingw-hybrid.

set -euo pipefail

die() { echo "[clion-start][FATAL] $*" >&2; exit 1; }

mode="${ENV_MODE:-mingw-hybrid}"
if [ "${1-}" != "" ] && [ "${1#-}" = "$1" ] && [ "$1" != "--" ]; then
  mode="$1"; shift || true
fi
if [ "${1-}" = "--" ]; then
  shift || true
fi

exec "$HOME/bin/clion-termux" "$mode" "$@"
