#!/data/data/com.termux/files/usr/bin/env bash
set -euo pipefail

unset CC CXX AR AS LD RANLIB STRIP OBJCOPY OBJDUMP NM
unset CFLAGS CXXFLAGS CPPFLAGS LDFLAGS LIBRARY_PATH LD_LIBRARY_PATH
unset CPATH C_INCLUDE_PATH CPLUS_INCLUDE_PATH
unset PKG_CONFIG PKG_CONFIG_PATH PKG_CONFIG_LIBDIR PKG_CONFIG_SYSROOT_DIR
unset SYSROOT NDK_HOME ANDROID_NDK_HOME ANDROID_HOME ANDROID_SDK_ROOT
unset PIP_NO_BINARY PIP_ONLY_BINARY PIP_PREFER_BINARY PIP_REQUIRE_VIRTUALENV
unset PIP_CONFIG_FILE

exec "$@"
