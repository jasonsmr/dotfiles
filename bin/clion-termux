#!/data/data/com.termux/files/usr/bin/bash
# clion-termux — run CLion with Termux/X11 expectations

set -euo pipefail

mode="${1:-${ENV_MODE:-mingw-hybrid}}"
shift || true

# shellcheck disable=SC1090
source "$HOME/bin/clion-env.sh" "$mode"

CLION_HOME="${CLION_HOME:-$HOME/opt/jetbrains/clion}"
if [ -x "$CLION_HOME/bin/clion.sh" ]; then
  exec "$CLION_HOME/bin/clion.sh" "$@"
fi

latest="$(ls -1d "$HOME/opt/jetbrains"/clion-* 2>/dev/null | sort | tail -n 1 || true)"
[ -n "$latest" ] || die "CLion not found under $HOME/opt/jetbrains (expected clion-* dirs)"
exec "$latest/bin/clion.sh" "$@"
