#!/data/data/com.termux/files/usr/bin/env bash
set -euo pipefail

# Point to the SDK aapt2 we trust (your build.gradle already enforces this path)
REAL="${ANDROID_AAPT2_REAL:-$HOME/opt/android-sdk/build-tools/34.0.4/aapt2}"

# Exec directly; Gradle props already disable daemon mode.
exec "$REAL" "$@"
