#!/data/data/com.termux/files/usr/bin/bash
# rider-start — unified launcher
# Usage: rider-start [ENV_MODE] [--] [args...]
set -euo pipefail

mode="${ENV_MODE:-mingw-hybrid}"
if [ "${1-}" != "" ] && [ "${1#-}" = "$1" ] && [ "$1" != "--" ]; then
  mode="$1"; shift || true
fi
if [ "${1-}" = "--" ]; then shift || true; fi

case "$mode" in
  debian-dev|debian-cev|debian|proot-debian|debian-xfce)
    exec "$HOME/bin/rider-debian" "$@"
    ;;
  *)
    exec "$HOME/bin/rider-termux" "$mode" "$@"
    ;;
esac
