# Force text normalization and LF line endings
*          text=auto eol=lf

# Always treat scripts and config as text
*.sh       text eol=lf
bin/*      text eol=lf
*.bash     text eol=lf
*.zsh      text eol=lf
*.kts      text eol=lf
*.gradle   text eol=lf
*.properties text eol=lf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.md       text eol=lf
*.txt      text eol=lf
*.xml      text eol=lf
*.cfg      text eol=lf
*.ini      text eol=lf
